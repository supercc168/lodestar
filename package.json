{
  "name": "@supercc168/lodestar",
  "version": "0.21.20",
  "publishConfig": {
    "access": "public"
  },
  "description": "Lodestar (夜航星) — IM-native frontend for Codex, Claude Agent SDK and DeepSeek Harness via Feishu Card Kit",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "license": "MIT",
  "author": "leviyuan",
  "homepage": "https://github.com/supercc168/lodestar#readme",
  "bugs": "https://github.com/supercc168/lodestar/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supercc168/lodestar.git"
  },
  "keywords": [
    "feishu",
    "lark",
    "codex",
    "openai",
    "ai",
    "agent",
    "im",
    "chat",
    "card-kit",
    "streaming",
    "lodestar"
  ],
  "scripts": {
    "start": "bun daemon.ts",
    "test": "bun test",
    "test:randomized": "bun test --randomize --seed=17",
    "typecheck": "tsc -p tsconfig.json",
    "ci": "bun run audit:production && bun run typecheck && bun run test && bun run test:randomized && bun run build",
    "audit:production": "bun audit --production",
    "build:daemon": "bun build cli.ts --target=node --packages=external --minify --banner='#!/usr/bin/env node' --outfile=dist/lodestar.js",
    "build:setup": "bun build src/setup-cli.ts --target=node --minify --banner='#!/usr/bin/env node' --outfile=dist/lodestar-setup.js",
    "build:stop": "bun build src/stop-cli.ts --target=node --minify --banner='#!/usr/bin/env node' --outfile=dist/lodestar-stop.js",
    "build:update": "bun build src/update-cli.ts --target=node --minify --banner='#!/usr/bin/env node' --outfile=dist/lodestar-update.js",
    "build:version": "bun build src/version-cli.ts --target=node --minify --banner='#!/usr/bin/env node' --outfile=dist/lodestar-version.js",
    "build:agent": "bun build src/agent-cli.ts --target=node --minify --banner='#!/usr/bin/env node' --outfile=dist/lodestar-agent.js",
    "build:claude": "bun build src/claude-cli.ts --target=node --minify --banner='#!/usr/bin/env node' --outfile=dist/lodestar-claude.js",
    "build": "bun run build:daemon && bun run build:setup && bun run build:stop && bun run build:update && bun run build:version && bun run build:agent && bun run build:claude && bun run build:dsh",
    "prepublishOnly": "bun run ci",
    "postinstall": "node scripts/postinstall.cjs",
    "build:dsh": "bun build src/dsh-bridge.ts --target=node --packages=external --outfile=dist/dsh-bridge.js"
  },
  "bin": {
    "lodestar-daemon": "./dist/lodestar.js",
    "lodestar-setup": "./dist/lodestar-setup.js",
    "lodestar-stop": "./dist/lodestar-stop.js",
    "lodestar-update": "./dist/lodestar-update.js",
    "lodestar-version": "./dist/lodestar-version.js",
    "lodestar-agent": "./dist/lodestar-agent.js",
    "lodestar-claude": "./dist/lodestar-claude.js"
  },
  "files": [
    "dist/",
    "skills/imagegen/",
    "skills/imageread/",
    "docs/",
    "scripts/postinstall.cjs",
    "src/data-dir.cjs",
    "src/codex-plugin-cache.cjs",
    "src/managed-skill-cleanup.cjs",
    "README.md",
    "LICENSE"
  ],
